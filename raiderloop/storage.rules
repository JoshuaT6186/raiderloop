rules_version = '2';
// Flyer Storage rules.
// The app may only upload into its own uploads/ folder: images up to
// 15 MB, or PDFs up to 25 MB. A Cloud Function checks and moderates
// each upload, then copies it to its final place with a private
// download link that only the right people ever receive. Nobody can
// list or read anyone else's files directly.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && ((request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size < 15 * 1024 * 1024)
          || (request.resource.contentType == 'application/pdf' && request.resource.size < 25 * 1024 * 1024));
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
